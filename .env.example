# =============================================================================
# WhaleAgent v0.1 — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- App ---
ENV=dev
LOG_LEVEL=INFO
ADMIN_USER_IDS=[]

# --- Telegram ---
BOT_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://whaleagent:whaleagent@localhost:5432/whaleagent
DATABASE_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_CHEAP_MODEL=llama-3.1-8b-instant
DEFAULT_STRONG_MODEL=llama-3.3-70b-versatile
MAX_COST_PER_RUN_USD=0.03

# --- Fallback LLMs (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Chain Providers ---
CHAIN_PROVIDER=alchemy
ALCHEMY_API_KEY=
ALCHEMY_BASE_URL=https://eth-mainnet.g.alchemy.com/v2
DRPC_API_KEY=
DRPC_BASE_URL=https://rpc.drpc.org
ANKR_API_KEY=
ANKR_BASE_URL=https://rpc.ankr.com
QUICKNODE_API_KEY=
QUICKNODE_BASE_URL=https://rpc.quiknode.pro
POLL_INTERVAL_SECONDS=30
POLL_BATCH_SIZE=50
REORG_SAFE_BLOCKS=64

# --- Alert Pipeline ---
ALERT_SCORE_THRESHOLD=50.0
FREE_ALERT_BATCH_INTERVAL_MINUTES=60
PAID_ALERT_BATCH_INTERVAL_SECONDS=5

# --- Billing ---
FREE_PLAN_CHAT_DAILY=5
PAID_PLAN_CHAT_DAILY=50
FREE_MAX_WALLETS=3
TELEGRAM_STARS_ENABLED=false
CRYPTO_PAYMENT_ADDRESS=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# App
ENV=dev
ADMIN_USER_IDS=[]

# Telegram
BOT_TOKEN=your_telegram_bot_token_here
# WEBHOOK_URL=https://your-app.railway.app/webhook
# WEBHOOK_SECRET=your_webhook_secret

# Channel Auto-Publishing
CHANNEL_CHAT_ID=your_channel_chat_id_or_username
CHANNEL_PUBLISH_ENABLED=True
CHANNEL_MAX_DAILY=20

# Database
DATABASE_URL=postgresql+asyncpg://whaledecode:whaledecode@localhost:5432/whaledecode
DATABASE_POOL_SIZE=10

# LLM — Gemini (heavy reasoning / briefing)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_HEAVY_REASONING=gemini-3.5-flash-lite

# LLM — Groq (structured data & fast chat)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_API_KEY_SECONDARY=gsk_your_second_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_STRUCTURED_DATA=llama-3.1-70b-versatile
MODEL_FAST_CHAT=llama-3.1-8b-instant
DEFAULT_CHEAP_MODEL=llama-3.1-8b-instant
DEFAULT_STRONG_MODEL=llama-3.1-70b-versatile
MAX_COST_PER_RUN_USD=0.03

# Chain Providers (RPC URLs per chain — at least one for real data)
ETH_RPC_URL=https://eth.llamarpc.com
ARB_RPC_URL=https://arbitrum.llamarpc.com
BASE_RPC_URL=https://base.llamarpc.com

# LangSmith Observability (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=ls_your_langsmith_api_key
LANGSMITH_PROJECT=WhaleDecode
POLL_INTERVAL_SECONDS=30
POLL_BATCH_SIZE=50
REORG_SAFE_BLOCKS=64

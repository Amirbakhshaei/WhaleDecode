# App
ENV=dev
ADMIN_USER_IDS=[]

# Telegram
BOT_TOKEN=your_telegram_bot_token_here
# WEBHOOK_URL=https://your-app.railway.app/webhook
# WEBHOOK_SECRET=your_webhook_secret

# Channel Auto-Publishing
CHANNEL_CHAT_ID=your_channel_chat_id_or_username
CHANNEL_PUBLISH_ENABLED=True
CHANNEL_MAX_DAILY=20

# Database
DATABASE_URL=postgresql+asyncpg://whaledecode:whaledecode@localhost:5432/whaledecode
DATABASE_POOL_SIZE=10

# LLM — Gemini (heavy reasoning / briefing)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_HEAVY_REASONING=gemini-3.5-flash-lite

# LLM — Groq (structured data & fast chat)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_API_KEY_SECONDARY=gsk_your_second_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_STRUCTURED_DATA=llama-3.3-70b-versatile
MODEL_FAST_CHAT=llama-3.1-8b-instant
DEFAULT_CHEAP_MODEL=llama-3.1-8b-instant
DEFAULT_STRONG_MODEL=llama-3.3-70b-versatile
MAX_COST_PER_RUN_USD=0.03

# Chain Providers
CHAIN_PROVIDER=drpc
DRPC_API_KEY=your_drpc_api_key

# LangSmith Observability (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls_your_langsmith_api_key
LANGCHAIN_PROJECT=whaledecode
# DRPC_BASE_URL=https://rpc.drpc.org
POLL_INTERVAL_SECONDS=30
POLL_BATCH_SIZE=50
REORG_SAFE_BLOCKS=64

{
  "project": "WhaleDecode",
  "mcp": {
    "servers": {
      "opencode": {
        "url": "http://localhost:3000"
      },

      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "enabled": true
      },
      "serena": {
        "type": "local",
        "command": ["npx", "-y", "serena"],
        "enabled": true
      },
      "memory": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
        "enabled": true
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
        "enabled": true
      }
    }
  },
  "commands": {
    "lint": "ruff check .",
    "typecheck": "mypy src",
    "test": "pytest",
    "test-unit": "pytest tests/unit",
    "test-integration": "pytest tests/integration",
    "test-graphs": "pytest tests/graphs",
    "format": "ruff format ."
  },
  "agent": {
    "atlas": {
      "prompt": "{file:./.opencode/agents/atlas.md}"
    },
    "forge": {
      "prompt": "{file:./.opencode/agents/forge.md}"
    },
    "prism": {
      "prompt": "{file:./.opencode/agents/prism.md}"
    },
    "quill": {
      "prompt": "{file:./.opencode/agents/quill.md}"
    }
  },
  "plugin": ["@dietrichgebert/ponytail", "@langchain/langsmith-opencode"]
}

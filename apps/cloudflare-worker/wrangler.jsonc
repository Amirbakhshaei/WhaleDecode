{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whaledecode-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whaledecode_db",
      "database_id": "70b64a07-98b5-42ae-a0b1-251c7d52f8c5",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 14 * * *"] },
  "observability": { "enabled": true, "logs": { "enabled": true }, "traces": { "enabled": true } },
  "vars": {
    "TELEGRAM_BOT_USERNAME": "WhaleDecodeBot",
    "LLM_MODEL": "gemini-2.5-flash",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "DRPC_URL": "https://eth.llamarpc.com"
  }
}

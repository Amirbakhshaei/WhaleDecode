{
  "name": "cloudflare-worker",
  "version": "1.0.0",
  "description": "WhaleDecode ingestion -> channel publishing pipeline on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply whaledecode --local",
    "migrate:remote": "wrangler d1 migrations apply whaledecode --remote",
    "register:webhooks": "node scripts/registerWebhooks.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
